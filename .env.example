# Set these in PHP-FPM / server environment, never in browser JavaScript.
MMS_ZHIPU_API_KEY=
# Use an absolute directory outside the document root in production.
MMS_PRIVATE_DIR=
MMS_ALLOWED_ORIGINS=https://www.azureflame.cloud,https://azureflame.cloud,https://appassets.androidapp.net
MMS_SMTP_HOST=
MMS_SMTP_PORT=465
MMS_SMTP_USER=
MMS_SMTP_PASS=
MMS_SMTP_FROM=
MMS_PUBLIC_ORIGIN=https://www.azureflame.cloud
# Shared market (Node.js service); MMS_PRIVATE_DIR must match PHP's private DB directory.
MMS_EXCHANGE_PORT=8098
# Only for isolated local development; production Nginx sends auth.php to existing PHP.
MMS_AUTH_UPSTREAM=
# Set to 1 only for an administrator-approved restart after a long outage.
MMS_EXCHANGE_RESUME=0

# Additive exact HTTPS origins for Toy auth and exchange only. Never use * or null.
MMS_TOY_ORIGINS=https://www.bilibili.com
